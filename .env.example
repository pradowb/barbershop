# Copy this file to .env and fill in the real values from your Supabase project
# (Settings -> API in the Supabase dashboard). Never commit the real .env file.

SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""

# Same values, exposed to the client bundle by Vite (must start with VITE_)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Only needed if/when server-side admin operations (supabaseAdmin) are used.
# This key bypasses Row Level Security — keep it out of the client bundle and
# out of git. Set it as a Cloudflare secret in production, never here.
# SUPABASE_SERVICE_ROLE_KEY=""